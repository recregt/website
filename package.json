{
  "name": "recregt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "react-router dev",
    "parvus": "mkdir -p .parvus && set -a && . ./.dev.vars && parvus",
    "studio": "pnpm --filter studio dev",
    "typegen": "pnpm --filter studio typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "build": "react-router build",
    "release": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "studio:build": "pnpm --filter studio build",
    "studio:release": "wrangler deploy -c studio/wrangler.jsonc",
    "check": "wrangler types && react-router typegen && tsc && tsc -p studio && biome ci ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "groq": "^6.20.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  }
}
