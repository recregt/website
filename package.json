{
  "name": "recregt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "react-router dev",
    "parvus": "mkdir -p .parvus && set -a && . ./.dev.vars && parvus",
    "studio": "pnpm --filter studio dev",
    "typegen": "pnpm --filter studio typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "build": "react-router build",
    "release": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "check": "wrangler types && react-router typegen && tsc && tsc -p studio && biome ci ."
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "groq": "^6.20.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  }
}
