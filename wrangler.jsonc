{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recregt",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "PARVUS_RP_ID": "recregt.com",
    "PARVUS_RP_NAME": "recregt",
    "PARVUS_ORIGINS": "https://recregt.com",
    "PARVUS_MAX_CREDENTIALS": "10",
    "PARVUS_DEV_URL": ""
  },
  "secrets": {
    "required": ["PARVUS_SECRET", "PARVUS_PEPPER", "PARVUS_DB"]
  },
  "containers": [
    {
      "class_name": "ParvusContainer",
      "image": "registry.cloudflare.com/2470a0a5c66adee503ba1e58e1860858/parvus:0.1.3"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PARVUS", "class_name": "ParvusContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ParvusContainer"] }],
  "dev": { "enable_containers": false }
}
